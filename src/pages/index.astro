---
import DefaultLayout from "../layouts/default.astro";
---

<DefaultLayout title="speculativesoftware.design">
	<main class="pulse">
		<h1>speculativesoftware.design</h1>
		<p>tbd...</p>
	</main>
</DefaultLayout>

<style>
	main {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		height: 100vh;
		opacity: 1;
	}

	.pulse {
		animation: pulse 10s infinite;
	}

	@keyframes pulse {
		0% {
			opacity: 0.9;
		}
		50% {
			opacity: 0.5;
		}
		100% {
			opacity: 0.9;
		}
	}
</style>
